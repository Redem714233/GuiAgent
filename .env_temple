# =====================================================
# GUIAgent .env template (推荐配置：VLM-only)
# =====================================================

# -----------------------------
# 1) 必填：VLM 配置
# -----------------------------
# 可选值示例：dashscope / qwen3-vl
VLM_PROVIDER=dashscope

# 你的 VLM OpenAI-compatible endpoint
VLM_BASE_URL=

# 模型名，例如 qwen3-vl-flash / Qwen/Qwen3-VL-32B-Instruct
VLM_MODEL=

# VLM API Key（推荐必填）
VLM_API_KEY=

# 是否禁用文本LLM（1=禁用，0=启用）
# 推荐：1（当前项目主流程）
DISABLE_TEXT_LLM=1


# -----------------------------
# 2) 必填：执行与特性开关
# -----------------------------
# DOM 标注模式（1=启用，0=使用OmniParser标注）
# 推荐：1
USE_DOM_ANNOTATION=1

# VLM 是否忽略 elements 文本列表（1=忽略，0=使用）
# 推荐：0
VLM_DISABLE_ELEMENTS=0

# 默认最大步骤数（不传 max_steps 时生效）
GUIAGENT_MAX_STEPS=5


# -----------------------------
# 3) 建议填写：浏览器
# -----------------------------
# 可选：msedge / chrome / firefox / webkit
PLAYWRIGHT_CHANNEL=msedge

# 可选：浏览器可执行文件路径（不填则使用 channel 默认路径）
PLAYWRIGHT_EXECUTABLE=

# 可选：启动后默认打开的网址
PLAYWRIGHT_START_URL=

# 建议默认值
PLAYWRIGHT_VIEWPORT_WIDTH=1280
PLAYWRIGHT_VIEWPORT_HEIGHT=720
PLAYWRIGHT_DEVICE_SCALE_FACTOR=1


# -----------------------------
# 4) 可选：文本LLM（仅在 DISABLE_TEXT_LLM=0 时需要）
# -----------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# DEEPSEEK_BASE_URL=
# OPENAI_MODEL=


# -----------------------------
# 5) 可选：OmniParser 运行路径补充
# -----------------------------
# Windows 可用分号分隔多个路径
OMNIPARSER_EXTRA_PATHS=
